# Anchored to the repository root on purpose. An unanchored `build/` matches
# a directory named `build` at ANY depth, and git on Windows matches ignore
# patterns case-insensitively, so it silently swallowed the whole of
# libs/BW_Build/include/BW/Build/ and libs/BW_Build/src/BW/Build/.
/build/
/install/
/out/
/dist/

# CPack writes these into whatever directory it is run from.
/_CPack_Packages/
/BuildWeather-*.zip

.vs/
.vscode/
.idea/
.cache/
*.user
CMakeUserPresets.json
compile_commands.json

# Local editor and assistant configuration; personal, not part of the project.
.claude/
CLAUDE.md

# Intermediate HTML from tools/build-docs.py; the .md and .pdf are tracked.
docs/_user_guide.html
docs/_captures/
