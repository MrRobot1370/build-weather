{
    "version": 6,
    "cmakeMinimumRequired": { "major": 3, "minor": 27, "patch": 0 },
    "configurePresets": [
        {
            "name": "base",
            "hidden": true,
            "binaryDir": "${sourceDir}/build/${presetName}",
            "installDir": "${sourceDir}/install/${presetName}",
            "cacheVariables": {
                "CMAKE_PREFIX_PATH": "C:/Qt/6.6.2/msvc2019_64"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "msvc-x64",
            "displayName": "Windows x64 (MSVC, Visual Studio generator)",
            "inherits": "base",
            "generator": "Visual Studio 17 2022",
            "architecture": { "value": "x64", "strategy": "set" },
            "toolset": { "value": "host=x64", "strategy": "set" }
        },
        {
            "name": "ninja-x64",
            "displayName": "Windows x64 (MSVC, Ninja)",
            "inherits": "base",
            "generator": "Ninja Multi-Config",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "cl.exe",
                "CMAKE_CXX_COMPILER": "cl.exe"
            },
            "architecture": { "value": "x64", "strategy": "external" },
            "toolset": { "value": "host=x64", "strategy": "external" }
        }
    ],
    "buildPresets": [
        { "name": "msvc-x64-debug",          "configurePreset": "msvc-x64",  "configuration": "Debug" },
        { "name": "msvc-x64-release",        "configurePreset": "msvc-x64",  "configuration": "Release" },
        { "name": "msvc-x64-relwithdebinfo", "configurePreset": "msvc-x64",  "configuration": "RelWithDebInfo" },
        { "name": "ninja-x64-release",       "configurePreset": "ninja-x64", "configuration": "Release" },
        { "name": "ninja-x64-debug",         "configurePreset": "ninja-x64", "configuration": "Debug" }
    ],
    "testPresets": [
        {
            "name": "msvc-x64-release",
            "configurePreset": "msvc-x64",
            "configuration": "Release",
            "output": { "outputOnFailure": true }
        },
        {
            "name": "ninja-x64-release",
            "configurePreset": "ninja-x64",
            "configuration": "Release",
            "output": { "outputOnFailure": true }
        }
    ]
}
